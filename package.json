{
  "name": "scientelier",
  "productName": "Scientelier",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "description": "Scientelier: a multi-agent research and development workspace for macOS.",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.cjs",
    "build": "tsc -b tsconfig.json tsconfig.renderer.json",
    "start": "electron .",
    "app:mac": "npm run build && node scripts/build-mac-app.cjs",
    "package:mac": "npm run build && node scripts/package-mac-app.cjs",
    "install:mac": "node scripts/install-mac.cjs",
    "setup": "node scripts/setup.cjs",
    "templates:ipsj": "node scripts/install-ipsj.cjs",
    "public:check": "node scripts/check-public-source.cjs",
    "public:export": "node scripts/export-public-source.cjs",
    "test:distribution": "node --test scripts/build-mac-app.test.cjs scripts/distribution.test.cjs",
    "test:distribution-ui": "electron scripts/smoke-distribution.cjs",
    "test": "node --test dist/core/*.test.js",
    "test:restart-runtime": "ELECTRON_RUN_AS_NODE=1 electron --test dist/core/task-restart.test.js dist/core/workflow-integration.test.js",
    "test:pdf": "node scripts/smoke-report.cjs",
    "test:documents": "node scripts/smoke-documents.cjs",
    "test:layout": "electron scripts/smoke-layout.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "electron": "^44.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289"
  }
}
